	</select>

	<!--根据ReportId更新-->
	<update id="updateByReportId" parameterType="com.yunnancommon.entity.po.ReportInfo">
		update report_info
		<set>
			<if test="bean.reportId != null">
				report_id = #{bean.reportId},
			</if>
			<if test="bean.constructionCount != null">
				construction_count = #{bean.constructionCount},
