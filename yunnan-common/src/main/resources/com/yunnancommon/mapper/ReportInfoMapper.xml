			</if>
			<if test="bean.reason1 != null">
				reason1,
			</if>
			<if test="bean.reason1Desc != null">
				reason1_desc,
			</if>
			<if test="bean.reason2 != null">
				reason2,
			</if>
			<if test="bean.reason2Desc != null">
				reason2_desc,
			</if>
			<if test="bean.reason3 != null">
				reason3,
			</if>
			<if test="bean.reason3Desc != null">
				reason3_desc,
			</if>
			<if test="bean.otherReason != null">
