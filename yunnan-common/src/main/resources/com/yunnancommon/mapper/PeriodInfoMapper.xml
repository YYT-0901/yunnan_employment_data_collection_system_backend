<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunnancommon.mapper.PeriodInfoMapper">
	<!--实体映射-->
	<resultMap id="base_result_map" type="com.yunnancommon.entity.po.PeriodInfo">
		<!--调查期ID(月)(时间戳)-->
		<id column="period_id" property="periodId" />
		<!--调查期标识-->
		<result column="investigate_time" property="investigateTime" />
		<!--填报开始时间-->
		<result column="period_start_time" property="periodStartTime" />
		<!--填报截止时间-->
		<result column="period_end_time" property="periodEndTime" />
		<!--此调查期之前的企业总数-->
		<result column="enterprise_count" property="enterpriseCount" />
		<!--创建时间-->
		<result column="created_at" property="createdAt" />
		<!--更新时间-->
		<result column="updated_at" property="updatedAt" />
	</resultMap>

	<!--通用查询结果-->
	<sql id="base_column_list">
		period_id,investigate_time,period_start_time,period_end_time,enterprise_count,created_at,updated_at
	</sql>

	<!--基础查询条件-->
	<sql id="base_query_condition">
		<if test="query.periodId != null">
			and period_id = #{query.periodId}
		</if>
		<if test="query.enterpriseCount != null">
			and enterprise_count = #{query.enterpriseCount}
		</if>
	</sql>

	<!--扩展查询条件-->
	<sql id="base_query_condition_extend">
	</sql>

	<!--通用查询条件-->
	<sql id="query_condition">
	<where>
		<include refid="base_query_condition" />
		<include refid="base_query_condition_extend" />
	</where>
	</sql>

	<!--查询列表-->
	<select id="selectList" resultMap="base_result_map">
		select
		<include refid="base_column_list" />
		from period_info
		<include refid="query_condition" />
		<if test="query.orderBy != null">order by ${query.orderBy}</if>
		<if test="query.simplePage != null">limit #{query.simplePage.start},#{query.simplePage.end}</if>
	</select>


	<!--查询数量-->
	<select id="selectCount" resultType="java.lang.Integer">
		select count(1)
		from period_info
		<include refid="query_condition" />
	</select>


	<!--单条插入-->
	<insert id="insert" parameterType="com.yunnancommon.entity.po.PeriodInfo">

		insert into period_info
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="bean.periodId != null">
				period_id,
			</if>
			<if test="bean.investigateTime != null">
				investigate_time,
			</if>
			<if test="bean.periodStartTime != null">
				period_start_time,
			</if>
			<if test="bean.periodEndTime != null">
				period_end_time,
			</if>
			<if test="bean.enterpriseCount != null">
				enterprise_count,
			</if>
			<if test="bean.createdAt != null">
				created_at,
			</if>
			<if test="bean.updatedAt != null">
				updated_at,
			</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="bean.periodId != null">
				#{bean.periodId},
			</if>
			<if test="bean.investigateTime != null">
				#{bean.investigateTime},
			</if>
			<if test="bean.periodStartTime != null">
				#{bean.periodStartTime},
			</if>
			<if test="bean.periodEndTime != null">
				#{bean.periodEndTime},
			</if>
			<if test="bean.enterpriseCount != null">
				#{bean.enterpriseCount},
			</if>
			<if test="bean.createdAt != null">
				#{bean.createdAt},
			</if>
			<if test="bean.updatedAt != null">
				#{bean.updatedAt},
			</if>
		</trim>
	</insert>

	<!--插入或更新-->
	<insert id="insertOrUpdate" parameterType="com.yunnancommon.entity.po.PeriodInfo">
		insert into period_info
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="bean.periodId != null">
				period_id,
			</if>
			<if test="bean.investigateTime != null">
				investigate_time,
			</if>
			<if test="bean.periodStartTime != null">
				period_start_time,
			</if>
			<if test="bean.periodEndTime != null">
				period_end_time,
			</if>
			<if test="bean.enterpriseCount != null">
				enterprise_count,
			</if>
			<if test="bean.createdAt != null">
				created_at,
			</if>
			<if test="bean.updatedAt != null">
				updated_at,
			</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="bean.periodId != null">
				#{bean.periodId},
			</if>
			<if test="bean.investigateTime != null">
				#{bean.investigateTime},
			</if>
			<if test="bean.periodStartTime != null">
				#{bean.periodStartTime},
			</if>
			<if test="bean.periodEndTime != null">
				#{bean.periodEndTime},
			</if>
			<if test="bean.enterpriseCount != null">
				#{bean.enterpriseCount},
			</if>
			<if test="bean.createdAt != null">
				#{bean.createdAt},
			</if>
			<if test="bean.updatedAt != null">
				#{bean.updatedAt},
			</if>
		</trim>
		on DUPLICATE key update
		<trim prefix="" suffix="" suffixOverrides=",">
			<if test="bean.investigateTime != null">
				investigate_time = VALUES(investigate_time),
			</if>
			<if test="bean.periodStartTime != null">
				period_start_time = VALUES(period_start_time),
			</if>
			<if test="bean.periodEndTime != null">
				period_end_time = VALUES(period_end_time),
			</if>
			<if test="bean.enterpriseCount != null">
				enterprise_count = VALUES(enterprise_count),
			</if>
			<if test="bean.createdAt != null">
				created_at = VALUES(created_at),
			</if>
			<if test="bean.updatedAt != null">
				updated_at = VALUES(updated_at),
			</if>
		</trim>
	</insert>

	<!--添加（批量插入）-->
	<insert id="insertBatch" parameterType="com.yunnancommon.entity.po.PeriodInfo">
		insert into period_info(period_id,enterprise_count) values
			<foreach collection="list" item="item" separator=",">
				(#{item.periodId},#{item.enterpriseCount})
			</foreach>
	</insert>


	<!--添加（批量插入或更新）-->
	<insert id="insertOrUpdateBatch" parameterType="com.yunnancommon.entity.po.PeriodInfo">
		insert into period_info(period_id,enterprise_count) values
			<foreach collection="list" item="item" separator=",">
				(#{item.periodId},#{item.enterpriseCount})
			</foreach>
		on DUPLICATE key update
			period_id = VALUES(period_id),enterprise_count = VALUES(enterprise_count)
	</insert>

	<!--根据PeriodId查询-->
	<select id="selectByPeriodId" resultMap="base_result_map">
		select <include refid="base_column_list" /> from period_info where period_id = #{periodId}
	</select>

	<!--根据PeriodId更新-->
	<update id="updateByPeriodId" parameterType="com.yunnancommon.entity.po.PeriodInfo">
		update period_info
		<set>
			<if test="bean.periodId != null">
				period_id = #{bean.periodId},
			</if>
			<if test="bean.investigateTime != null">
				investigate_time = #{bean.investigateTime},
			</if>
			<if test="bean.periodStartTime != null">
				period_start_time = #{bean.periodStartTime},
			</if>
			<if test="bean.periodEndTime != null">
				period_end_time = #{bean.periodEndTime},
			</if>
			<if test="bean.enterpriseCount != null">
				enterprise_count = #{bean.enterpriseCount},
			</if>
			<if test="bean.createdAt != null">
				created_at = #{bean.createdAt},
			</if>
			<if test="bean.updatedAt != null">
				updated_at = #{bean.updatedAt},
			</if>
		</set>
		where period_id = #{periodId}
	</update>

	<!--根据PeriodId删除-->
	<delete id="deleteByPeriodId">
		delete from period_info where period_id = #{periodId}
	</delete>


</mapper>
